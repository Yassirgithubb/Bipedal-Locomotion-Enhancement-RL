    <!-- Shell self filtering -->
    <self_filter>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="1.05 0.5 0.5"/>
      </geometry>
    </self_filter>
  </link>
  <!-- Fixed joint to add front handle link -->
  <joint name="base_to_front_handle" type="fixed">
    <parent link="base"/>
    <child link="front_handle"/>
    <origin rpy="0 0 0" xyz="0.36 0 0.13"/>
  </joint>
  <!-- Front handle link -->
  <!-- Added as a separate link due to velocity="30"ation in point_cloud_self_filter -->
  <link name="front_handle">
