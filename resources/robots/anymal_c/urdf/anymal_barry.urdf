<?xml version="1.0" ?>
<!-- This file contains the description of the ANYmal robot. -->
<robot name="barry">
  <!-- Colors -->
  <material name="anymal_material">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="barry_material">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>
  <!-- [kg * m^2] -->
  <!-- [m] -->
  <!-- measured -->
  <!-- Base link -->
  <link name="base">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.018 -0.002 0.024"/>
      <mass value="6.222"/>
      <inertia ixx="0.017938806" ixy="0.00387963" ixz="0.001500772" iyy="0.370887745" iyz="6.8963e-05" izz="0.372497653"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/base.dae" scale="1.0 1.0     1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 1.57079632679 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.75" radius="0.075"/>
      </geometry>
    </collision>
